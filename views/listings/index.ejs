<% layout("layouts/boilerplate") %>

    <!-- <h1>All Listing</h1> -->
    <!-- <form action="/listings/new" method="get">
            <button>Create New Listing</button>
        </form> -->

    <style>
        #filters {
            /* margin-top: 1rem; */
            display: flex;
            flex-wrap: wrap;
            align-items: center;
        }

        .filter {
            margin-right: 2rem;
            text-align: center;
            margin-top: 2rem;
            opacity: 0.7;

        }

        .filter i {
            font-size: 1.2rem;
        }

        .filter p {
            font-size: 0.8rem;
        }

        .filter:hover {
            opacity: 1;
            cursor: pointer;
        }

        .filter.active {
            opacity: 1;
            border-bottom: 2px solid black;
        }

        .tax-info {
            display: none;
        }

        .tax-toggle {

            border: 1px solid black;
            height: 3.25rem;
            border-radius: 1rem;
            padding: 0.5rem 1rem;
            margin-left: 2rem;
            display: flex;
            align-items: center;

        }
    </style>

    <div id="filters">
        <a href="/listings?category=Trending" class="filter <%= (typeof category !== 'undefined' && category === 'Trending') ? 'active' : '' %>" style="text-decoration: none; color: inherit;">
            <div><i class="fa-solid fa-fire"></i></div>
            <p>Trending</p>
        </a>

        <a href="/listings?category=Rooms" class="filter <%= (typeof category !== 'undefined' && category === 'Rooms') ? 'active' : '' %>" style="text-decoration: none; color: inherit;">
            <div><i class="fa-solid fa-bed"></i></div>
            <p>Rooms</p>
        </a>
        <a href="/listings?category=Iconic cities" class="filter <%= (typeof category !== 'undefined' && category === 'Iconic cities') ? 'active' : '' %>" style="text-decoration: none; color: inherit;">
            <div><i class="fa-solid fa-mountain-city"></i></div>
            <p>Iconic cities</p>
        </a>
        <a href="/listings?category=mountains" class="filter <%= (typeof category !== 'undefined' && category === 'mountains') ? 'active' : '' %>" style="text-decoration: none; color: inherit;">
            <div><i class="fa-solid fa-mountain-sun"></i></div>
            <p>mountains</p>
        </a>
        <a href="/listings?category=castles" class="filter <%= (typeof category !== 'undefined' && category === 'castles') ? 'active' : '' %>" style="text-decoration: none; color: inherit;">
            <div><i class="fa-brands fa-fort-awesome"></i></div>
            <p>castles</p>
        </a>
        <a href="/listings?category=Amazing Pools" class="filter <%= (typeof category !== 'undefined' && category === 'Amazing Pools') ? 'active' : '' %>" style="text-decoration: none; color: inherit;">
            <div><i class="fa-solid fa-person-swimming"></i></div>
            <p>Amazing Pools</p>
        </a>
        <a href="/listings?category=Camping" class="filter <%= (typeof category !== 'undefined' && category === 'Camping') ? 'active' : '' %>" style="text-decoration: none; color: inherit;">
            <div><i class="fa-solid fa-tent"></i></div>
            <p>Camping</p>
        </a>
        <a href="/listings?category=Farms" class="filter <%= (typeof category !== 'undefined' && category === 'Farms') ? 'active' : '' %>" style="text-decoration: none; color: inherit;">
            <div><i class="fa-solid fa-building-wheat"></i></div>
            <p>Farms</p>
        </a>
        <a href="/listings?category=Arctic" class="filter <%= (typeof category !== 'undefined' && category === 'Arctic') ? 'active' : '' %>" style="text-decoration: none; color: inherit;">
            <div><i class="fa-solid fa-snowman"></i></div>
            <p>Arctic</p>
        </a>
        <a href="/listings?category=Domes" class="filter <%= (typeof category !== 'undefined' && category === 'Domes') ? 'active' : '' %>" style="text-decoration: none; color: inherit;">
            <div><i class="fa-solid fa-igloo"></i></div>
            <p>Domes</p>
        </a>
        <a href="/listings?category=Play" class="filter <%= (typeof category !== 'undefined' && category === 'Play') ? 'active' : '' %>" style="text-decoration: none; color: inherit;">
            <div><i class="fa-solid fa-baseball-bat-ball"></i></div>
            <p>Play</p>
        </a>

        <div class="tax-toggle">
            <div class="form-check-reverse form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
                <label class="form-check-label" for="switchCheckDefault">Display total including taxes</label>
            </div>
        </div>
    </div>

    <% if ((typeof category !== 'undefined' && category) || (typeof q !== 'undefined' && q)) { %>
        <div class="mt-3 mb-2" style="font-size: 1.1rem; color: #555;">
            <% if (typeof category !== 'undefined' && category) { %>
                Filtered by: <b><%= category %></b> 
            <% } %>
            <% if (typeof q !== 'undefined' && q) { %>
                <%= (typeof category !== 'undefined' && category) ? ' | ' : '' %>
                Searched for: <b>"<%= q %>"</b> 
            <% } %>
            (<%= allListings.length %> listing<%= allListings.length === 1 ? '' : 's' %>) 
            <a href="/listings" style="color: #ff385c; text-decoration: none; font-weight: 500; margin-left: 10px;">Clear</a>
        </div>
    <% } %>


    <div class="row row-cols-lg-3 row-cols-md-3 row-cols-sm-1 mt-3">
        <% if (allListings.length === 0) { %>
            <div class="col-12 mt-5">
                <h4>No listing found</h4>
                <p>We couldn't find any listings matching your search or filter.</p>
            </div>
        <% } %>
        <% for(let listing of allListings) { %>
            <div class="col">
                <a href="/listings/<%= listing._id %>" class="listing-link">
                    <div class="card listing-card">
                        <img src="<%= listing.image.url %>" class="card-img-top" alt="listing image"
                            style="height: 20rem;" />
                        <div class="card-img-overlay"></div>
                        <div class="card-body">

                            <p class="card-text">
                                <b>
                                    <%= listing.title %>
                                </b> <br>
                                &#8377; <%= listing.price.toLocaleString("en-IN") %> /night
                                    <i class="tax-info"> &nbsp; &nbsp; +18% GST</i>
                            </p>

                        </div>
                    </div>
                </a>
            </div>
            <% } %>
    </div>

    <script>
        let taxSwitch = document.getElementById("switchCheckDefault");
        taxSwitch.addEventListener("click", () => {
            let taxInfo = document.getElementsByClassName("tax-info");
            for (info of taxInfo) {
                if (info.style.display == "inline") {
                    info.style.display = "none";
                } else {
                    info.style.display = "inline";
                }
            }

        })
    </script>